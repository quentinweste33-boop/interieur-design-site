---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout
  title="Contact"
  description="Contactez le studio Interieur Design pour discuter de votre projet d'architecture d'intérieur en Polynésie française."
>
  <section class="mx-auto grid max-w-[1400px] grid-cols-1 gap-16 px-6 pt-20 pb-32 md:grid-cols-2 md:px-10">
    <div>
      <p class="mb-4 text-xs tracking-[0.35em] text-bronze uppercase" data-reveal>
        Contact
      </p>
      <h1 class="mb-8 font-serif text-4xl leading-tight md:text-5xl" data-reveal>
        Parlons de votre projet
      </h1>
      <p class="mb-12 max-w-md text-anthracite/70" data-reveal>
        Résidence privée, établissement hôtelier, boutique ou scénographie —
        décrivez-nous votre projet, nous revenons vers vous sous 48h.
      </p>

      <div class="space-y-4 text-sm text-anthracite/70" data-reveal>
        <p>Papeete, Tahiti, Polynésie française</p>
        <p>contact@interieur-design.pf</p>
        <p>+689 87 00 00 00</p>
      </div>
    </div>

    <div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
