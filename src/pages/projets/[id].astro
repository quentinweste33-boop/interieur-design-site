---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectStoryGallery from "../../components/ProjectStoryGallery.astro";
import ProjectPhotoGallery from "../../components/ProjectPhotoGallery.astro";
import BrandDivider from "../../components/BrandDivider.astro";
import { categories, projects, getGallerySections } from "../../data/projects";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const categoryLabel = Object.fromEntries(categories.map((c) => [c.slug, c.label]))[
  project.category
];

// Nom donné par Nathalie au projet (ex. "SAGE") : tant qu'il n'est pas
// renseigné, le bandeau d'ouverture affiche le titre descriptif à la place —
// jamais de "null" ni de champ vide.
const bannerName = project.nom ?? project.title;

// Surface / mission / année / lieu sont optionnels : un champ non renseigné
// n'est jamais affiché (ni valeur inventée, ni cellule vide), et la grille
// s'adapte au nombre de champs restants.
const meta = [
  { label: "Surface", value: project.surface },
  { label: "Mission", value: project.mission },
  { label: "Année", value: project.year },
  { label: "Lieu", value: project.location },
].filter((item) => item.value);

const metaColumns = {
  1: "sm:grid-cols-1",
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
  4: "sm:grid-cols-4",
}[meta.length];

// Texte de présentation : plusieurs paragraphes (body) ou un seul (description).
const paragraphs = project.body ?? [project.description];

const gallerySections = project.photos ? [] : getGallerySections(project);
---

<BaseLayout
  title={project.title}
  description={project.description}
  ogImage={project.cover}
  overlayHeader
>
  <section class="relative flex h-[80vh] w-full items-center justify-center overflow-hidden md:h-[90vh]">
    <img
      src={project.cover}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <!-- Dégradé sauge/anthracite (pas de noir dur) : assure la lisibilité du
         nom et de la nav superposée, sans écraser la photo. -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-anthracite/55 via-anthracite/20 to-anthracite/60"
    >
    </div>

    <a
      href="/projets"
      class="absolute left-6 top-24 z-10 text-xs tracking-[0.2em] text-ivoire/80 uppercase transition-colors hover:text-ivoire md:left-10 md:top-28"
      data-reveal
    >
      ← Retour aux projets
    </a>

    <div class="relative z-10 max-w-4xl px-6 text-center">
      <p
        class="font-serif text-3xl leading-tight font-normal text-ivoire uppercase break-words sm:text-5xl sm:leading-none sm:tracking-[0.02em] md:text-7xl md:tracking-[0.04em]"
        data-reveal
      >
        {bannerName}
      </p>
      <p
        class="mt-5 text-xs tracking-[0.4em] text-ivoire/80 uppercase md:text-sm"
        data-reveal
      >
        {categoryLabel}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pt-20 pb-32 md:px-10">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div data-reveal>
        <h1 class="font-serif text-4xl leading-tight font-normal md:text-5xl">
          {project.title}
        </h1>
        <p class="mt-2 font-serif text-2xl text-sauge">{project.subtitle}</p>
      </div>

      <div class="shrink-0 space-y-1 text-sm md:text-right" data-reveal>
        <p class="text-xs tracking-[0.2em] text-anthracite/50 uppercase">
          {categoryLabel}
        </p>
        {project.location && (
          <p class="text-anthracite/70">{project.location}, Polynésie française</p>
        )}
        {project.mission && <p class="text-anthracite/70">{project.mission}</p>}
      </div>
    </div>

    <div class="mt-14 max-w-2xl space-y-5 leading-relaxed text-anthracite/80" data-reveal>
      {paragraphs.map((text) => <p>{text}</p>)}
    </div>

    {
      meta.length > 0 && (
        <div
          class={`mt-14 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-pierre/40 pt-10 ${metaColumns}`}
          data-reveal
        >
          {meta.map((item) => (
            <div>
              <p class="text-[0.65rem] tracking-[0.2em] text-anthracite/50 uppercase">{item.label}</p>
              <p class="mt-1 text-sm text-anthracite/80">{item.value}</p>
            </div>
          ))}
        </div>
      )
    }

    <div class="mt-24 md:mt-32">
      <BrandDivider class="mb-20 md:mb-24" />
      {
        project.photos ? (
          <ProjectPhotoGallery photos={project.photos} />
        ) : (
          <ProjectStoryGallery entries={gallerySections} projectTitle={project.title} />
        )
      }
    </div>
  </section>
</BaseLayout>
