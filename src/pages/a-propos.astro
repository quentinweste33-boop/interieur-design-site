---
import BaseLayout from "../layouts/BaseLayout.astro";
import { founderPortrait } from "../data/projects";
import ServicesCarousel from "../components/ServicesCarousel.astro";
---

<BaseLayout
  title="À propos"
  description="Intérieur Design Tahiti, agence d'architecture d'intérieur au cœur de Papeete, conçoit des espaces intérieurs exceptionnels inspirés de la culture et des matériaux naturels polynésiens."
  ogImage={founderPortrait}
>
  <section class="grid grid-cols-1 md:grid-cols-2">
    <div class="order-2 flex items-center px-6 py-20 md:order-1 md:px-16 md:py-0">
      <div class="max-w-lg">
        <p class="mb-4 text-xs tracking-[0.35em] text-bronze uppercase" data-reveal>
          À propos
        </p>
        <h1 class="mb-8 font-serif text-4xl leading-tight font-normal md:text-5xl" data-reveal>
          Création, élégance & personnalisation.
        </h1>

        <div class="space-y-5 leading-relaxed text-anthracite/80" data-reveal>
          <p>
            Intérieur Design Tahiti est une agence de renommée située au cœur de
            Papeete, spécialisée dans la conception et la réalisation d'espaces
            intérieurs exceptionnels. Notre équipe d'architectes d'intérieur
            talentueux et expérimentés s'engage à transformer vos idées en
            réalité, en créant des environnements harmonieux et fonctionnels qui
            reflètent votre style et vos besoins uniques. Forts de notre
            connaissance approfondie de la culture et du mode de vie polynésiens,
            nous intégrons des éléments locaux et des matériaux naturels pour
            concevoir des espaces authentiques et inspirants.
          </p>
        </div>

        <blockquote class="mt-10 border-t border-pierre/40 pt-8" data-reveal>
          <p class="font-serif text-2xl leading-snug italic md:text-3xl">
            « Imaginer, révéler et transformer les lieux afin qu'ils deviennent
            des espaces inspirants, alignés avec ceux qui les vivent — telle est
            la philosophie d'Interieur Design Tahiti by Nathalie Weste. »
          </p>
        </blockquote>

        <a
          href="/contact"
          class="mt-10 inline-block border-b border-anthracite/40 pb-1 text-sm tracking-wide hover:border-anthracite"
          data-reveal
        >
          Échanger sur votre projet →
        </a>
      </div>
    </div>

    <div class="order-1 h-[60vh] md:order-2 md:h-screen">
      <img
        src={founderPortrait}
        alt="Portrait de Nath, fondatrice d'Interieur Design"
        class="h-full w-full object-cover"
        width="1200"
        height="1500"
      />
    </div>
  </section>

  <ServicesCarousel />
</BaseLayout>
