---
import BaseLayout from "../layouts/BaseLayout.astro";
import { about } from "../data/about";
import ServicesCarousel from "../components/ServicesCarousel.astro";
import BrandDivider from "../components/BrandDivider.astro";
---

<BaseLayout
  title="À propos"
  description="Nathalie Weste, fondatrice d'Interieur Design Tahiti, accompagne depuis plus de 17 ans particuliers et professionnels dans leurs projets d'aménagement, de rénovation et de décoration intérieure en Polynésie française."
  ogImage={about.photo}
>
  <section class="grid grid-cols-1 md:grid-cols-2">
    <div class="order-2 flex items-center px-6 py-20 md:order-1 md:px-16 md:py-0">
      <div class="max-w-lg">
        <p class="mb-4 text-xs tracking-[0.35em] text-bronze uppercase" data-reveal>
          {about.eyebrow}
        </p>
        <h1 class="font-serif text-4xl leading-tight font-normal md:text-5xl" data-reveal>
          {about.title}
        </h1>
        <p class="mt-2 mb-8 font-serif text-2xl text-sauge" data-reveal>
          {about.subtitle}
        </p>

        <div class="space-y-5 leading-relaxed text-anthracite/80" data-reveal>
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-10">
          <BrandDivider class="justify-start" />
        </div>
        <blockquote class="pt-8" data-reveal>
          <p class="font-serif text-2xl leading-snug md:text-3xl">
            « Imaginer, révéler et transformer les lieux afin qu'ils deviennent
            des espaces inspirants, alignés avec ceux qui les vivent — telle est
            la philosophie d'Interieur Design Tahiti by Nathalie Weste. »
          </p>
        </blockquote>

        <a
          href="/contact"
          class="mt-10 inline-block border-b border-anthracite/40 pb-1 text-sm tracking-wide hover:border-anthracite"
          data-reveal
        >
          Échanger sur votre projet →
        </a>
      </div>
    </div>

    <div class="relative order-1 h-[60vh] md:order-2 md:h-screen">
      <img
        src={about.photo}
        alt={`Portrait de ${about.photoCaption}`}
        class="h-full w-full object-cover"
        width="1200"
        height="1800"
      />
      <p
        class="absolute bottom-8 left-8 bg-anthracite/70 px-4 py-2 text-xs tracking-[0.2em] text-ivoire uppercase backdrop-blur-sm"
      >
        {about.photoCaption}
      </p>
    </div>
  </section>

  <div class="pt-20 md:pt-24">
    <BrandDivider />
  </div>
  <ServicesCarousel />
</BaseLayout>
