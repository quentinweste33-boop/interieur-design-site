---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  overlayHeader?: boolean;
}

const {
  title,
  description = "Interieur Design — architecture d'intérieur haut de gamme en Polynésie française.",
  overlayHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} — Interieur Design</title>
  </head>
  <body class="overflow-x-hidden bg-ivoire text-anthracite">
    <Header overlay={overlayHeader} />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import "../scripts/smooth-scroll.js";
      import "../scripts/reveal-animations.js";
    </script>
  </body>
</html>
