---
import { services } from "../data/services";
---

<div class="mx-auto max-w-[1400px] px-6 py-28 md:px-10">
  <div class="mb-14 flex flex-col justify-between gap-8 md:flex-row md:items-end">
    <div>
      <p class="mb-4 text-xs tracking-[0.35em] text-bronze uppercase" data-reveal>
        Nos services
      </p>
      <h2 class="max-w-md font-serif text-4xl leading-tight font-normal md:text-5xl" data-reveal>
        De la conception à la réalisation.
      </h2>
    </div>
    <p class="max-w-md text-anthracite/70" data-reveal>
      Notre studio accompagne chaque projet de la première esquisse à la remise
      des clés, avec une équipe resserrée et une exigence constante de qualité,
      du dessin d'exécution jusqu'au choix du dernier objet.
    </p>
  </div>

  <div data-carousel>
    <div
      data-carousel-track
      class="carousel-track flex snap-x snap-mandatory gap-8 overflow-x-auto scroll-smooth"
    >
      {
        services.map((service) => (
          <div
            data-carousel-card
            class="shrink-0 basis-full snap-start sm:basis-[calc(50%-1rem)] lg:basis-[calc(33.3333%-1.3333rem)]"
            data-reveal
          >
            <div class="aspect-[4/3] overflow-hidden bg-beige">
              <img
                src={service.image}
                alt={`Illustration du service ${service.title}`}
                loading="lazy"
                width="1200"
                height="900"
                class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-105"
              />
            </div>
            <div class="mt-6 flex items-center gap-4">
              <span class="font-serif text-3xl text-sauge">{service.number}</span>
              <span class="h-px flex-1 bg-pierre/50" />
            </div>
            <h3 class="mt-3 font-serif text-2xl font-normal">{service.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-anthracite/70">
              {service.description}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex justify-end gap-3">
      <button
        type="button"
        data-carousel-prev
        aria-label="Service précédent"
        class="flex h-12 w-12 items-center justify-center border border-anthracite/30 text-anthracite transition-colors hover:border-anthracite disabled:cursor-not-allowed disabled:opacity-30"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </button>
      <button
        type="button"
        data-carousel-next
        aria-label="Service suivant"
        class="flex h-12 w-12 items-center justify-center border border-anthracite/30 text-anthracite transition-colors hover:border-anthracite disabled:cursor-not-allowed disabled:opacity-30"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  import "../scripts/carousel.js";
</script>
