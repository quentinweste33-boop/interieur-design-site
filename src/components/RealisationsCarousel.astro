---
import { realisations } from "../data/realisations";
---

<div class="mx-auto max-w-[1400px] px-6 py-28 md:px-10">
  <p class="mb-14 text-xs tracking-[0.35em] text-bronze uppercase" data-reveal>
    Réalisations
  </p>

  <div data-carousel>
    <div
      data-carousel-track
      class="carousel-track flex snap-x snap-mandatory gap-8 overflow-x-auto scroll-smooth"
    >
      {
        realisations.map((item) => (
          <div
            data-carousel-card
            class="shrink-0 basis-full snap-start lg:basis-[calc(50%-1rem)]"
            data-reveal
          >
            <div class="aspect-[4/3] overflow-hidden bg-beige">
              <img
                src={item.image}
                alt={`Réalisation — ${item.title}`}
                loading="lazy"
                width="1600"
                height="1200"
                class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-105"
              />
            </div>
            <div class="mt-4 flex items-baseline justify-between">
              <p class="font-serif text-lg font-normal">{item.title}</p>
              <span class="text-xs tracking-[0.2em] text-anthracite/50 uppercase">
                {item.category}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex justify-end gap-3">
      <button
        type="button"
        data-carousel-prev
        aria-label="Réalisation précédente"
        class="flex h-12 w-12 items-center justify-center border border-anthracite/30 text-anthracite transition-colors hover:border-anthracite disabled:cursor-not-allowed disabled:opacity-30"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </button>
      <button
        type="button"
        data-carousel-next
        aria-label="Réalisation suivante"
        class="flex h-12 w-12 items-center justify-center border border-anthracite/30 text-anthracite transition-colors hover:border-anthracite disabled:cursor-not-allowed disabled:opacity-30"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  import "../scripts/carousel.js";
</script>
