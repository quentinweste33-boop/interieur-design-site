---
interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const { pathname } = Astro.url;

const links = [
  { href: "/", label: "Accueil" },
  { href: "/projets", label: "Projets" },
  { href: "/a-propos", label: "À propos" },
  { href: "/contact", label: "Contact" },
];
---

<header
  id="site-header"
  data-overlay={overlay ? "true" : "false"}
  class:list={[
    "fixed inset-x-0 top-0 z-40 border-b transition-[background-color,color,border-color,box-shadow] duration-500",
    overlay
      ? "border-transparent bg-transparent text-ivoire"
      : "border-pierre/40 bg-ivoire/95 text-anthracite backdrop-blur-sm",
  ]}
>
  <div class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-6 md:px-10">
    <a href="/" class="relative block h-14 w-[68px] shrink-0 md:h-16 md:w-[78px]">
      <img
        src="/logo/logo-couleur.png"
        alt="Interieur Design Tahiti — accueil"
        width="1024"
        height="829"
        class="logo-color absolute inset-0 h-full w-full object-contain object-left transition-opacity duration-500"
      />
      <img
        src="/logo/logo-blanc.png"
        alt=""
        aria-hidden="true"
        width="1024"
        height="829"
        class="logo-white absolute inset-0 h-full w-full object-contain object-left opacity-0 transition-opacity duration-500"
      />
    </a>

    <nav class="hidden gap-10 text-[0.7rem] tracking-[0.2em] uppercase md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "transition-opacity hover:opacity-60",
              pathname === link.href ? "opacity-100" : "opacity-70",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-toggle"
      class="text-[0.7rem] tracking-[0.2em] uppercase md:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-6 bg-anthracite px-6 py-10 text-center text-lg text-ivoire md:hidden"
  >
    {
      links.map((link) => (
        <a href={link.href} class="font-serif tracking-[0.15em] uppercase">
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  // Rattaché via astro:page-load (et non exécuté une seule fois au chargement
  // du module) car le header — donc #menu-toggle — est recréé à chaque
  // transition de page avec les View Transitions d'Astro.
  function initMobileMenu() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu) return;

    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("flex");
      menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    });
  }

  document.addEventListener("astro:page-load", initMobileMenu);
</script>

<style>
  /* Logo blanc (fonds sombres : hero overlay) visible uniquement tant que le
     header est transparent ; logo couleur dès qu'un fond clair apparaît
     (scroll ou pages sans overlay) — réutilise l'état déjà géré par
     header-scroll.js (attribut data-overlay + classe .is-scrolled). */
  #site-header[data-overlay="true"]:not(.is-scrolled) .logo-white {
    opacity: 1;
  }

  #site-header[data-overlay="true"]:not(.is-scrolled) .logo-color {
    opacity: 0;
  }
</style>
