---
import { projects } from "../data/projects";

// Sélection par id (et non par index) : l'ordre du tableau projects évolue à
// chaque nouveau projet réel ajouté.
const featuredIds = ["hotel-le-corail", "boutique-heiva", "niu-beach-hotel-moorea", "restaurant-la-perle"];
const featured = featuredIds.map((id) => projects.find((p) => p.id === id));
---

<section class="mx-auto max-w-[1400px] px-6 py-28 md:px-10">
  <div class="mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
    <h2 class="max-w-lg font-serif text-3xl leading-tight font-normal md:text-4xl" data-reveal>
      Une sélection de projets, entre hôtellerie et résidences privées
    </h2>
    <a
      href="/projets"
      class="shrink-0 border-b border-anthracite/40 pb-1 text-sm tracking-wide hover:border-anthracite"
      data-reveal
    >
      Voir tout le portfolio →
    </a>
  </div>

  <div class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2">
    {
      featured.map((project) => (
        <a href="/projets" class="group block" data-reveal>
          <div class="aspect-[4/3] overflow-hidden bg-beige">
            <img
              src={project.cover}
              alt={project.location ? `Intérieur du projet ${project.title}, ${project.location}` : `Intérieur du projet ${project.title}`}
              loading="lazy"
              width="1600"
              height="1067"
              class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
            />
          </div>
          <div class="mt-4">
            <p class="font-serif text-lg font-normal">{project.title}</p>
            {project.location && (
              <p class="text-xs tracking-wide text-anthracite/50">{project.location}</p>
            )}
          </div>
        </a>
      ))
    }
  </div>
</section>
