---
import { categories, projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

const categoryLabel = Object.fromEntries(categories.map((c) => [c.slug, c.label]));
---

<div>
  <div
    class="mb-14 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm tracking-wide"
    data-reveal
  >
    <button data-filter="tous" class="text-anthracite transition-colors">Tous</button>
    {
      categories.map((cat) => (
        <button
          data-filter={cat.slug}
          class="text-anthracite/40 transition-colors hover:text-anthracite"
        >
          {cat.label}
        </button>
      ))
    }
  </div>

  <div class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3" data-stagger-grid>
    {
      projects.map((project) => (
        <ProjectCard project={project} categoryLabel={categoryLabel[project.category]} />
      ))
    }
  </div>
</div>

<script>
  import "../scripts/project-filter.js";
  import "../scripts/card-parallax.js";
</script>
