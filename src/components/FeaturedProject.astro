---
import { categories, featuredProject } from "../data/projects";

const categoryLabel = Object.fromEntries(categories.map((c) => [c.slug, c.label]))[
  featuredProject.category
];
const sectorLine = [featuredProject.sector ?? categoryLabel, featuredProject.rating]
  .filter(Boolean)
  .join(" · ");

const meta = [
  { label: "Surface", value: featuredProject.surface },
  { label: "Mission", value: featuredProject.mission },
  { label: "Année", value: featuredProject.year },
  { label: "Lieu", value: featuredProject.location },
];
---

<section class="mx-auto max-w-[1400px] px-6 py-28 md:px-10">
  <p class="mb-14 text-xs tracking-[0.35em] text-bronze uppercase" data-reveal>
    Projet phare
  </p>

  <div class="flex flex-col justify-between gap-8 md:flex-row md:items-start">
    <div data-reveal>
      <h2 class="font-serif text-4xl leading-tight font-normal md:text-5xl">
        {featuredProject.title}
      </h2>
      <p class="mt-2 font-serif text-2xl text-sauge italic">{featuredProject.subtitle}</p>
    </div>

    <div class="shrink-0 space-y-1 text-sm md:text-right" data-reveal>
      <p class="text-xs tracking-[0.2em] text-anthracite/50 uppercase">{sectorLine}</p>
      <p class="text-anthracite/70">{featuredProject.location}, Polynésie française</p>
      <p class="text-anthracite/70">{featuredProject.mission}</p>
    </div>
  </div>

  <div
    class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-3 md:grid-rows-2 md:h-[640px] md:gap-6"
    data-reveal
  >
    <a
      href={`/projets/${featuredProject.id}`}
      class="group block aspect-[4/3] overflow-hidden bg-beige md:col-span-2 md:row-span-2 md:aspect-auto md:h-full"
      aria-label={`Découvrir le projet ${featuredProject.title}`}
    >
      <img
        src={featuredProject.images[0]}
        alt={`Intérieur du projet ${featuredProject.title} — vue principale, ${featuredProject.location}`}
        loading="lazy"
        width="2000"
        height="1500"
        class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
      />
    </a>
    <a
      href={`/projets/${featuredProject.id}`}
      class="group block aspect-[4/3] overflow-hidden bg-beige md:aspect-auto md:h-full"
      aria-label={`Découvrir le projet ${featuredProject.title}`}
    >
      <img
        src={featuredProject.images[1]}
        alt={`Intérieur du projet ${featuredProject.title} — vue secondaire, ${featuredProject.location}`}
        loading="lazy"
        width="1200"
        height="1600"
        class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
      />
    </a>
    <a
      href={`/projets/${featuredProject.id}`}
      class="group block aspect-[4/3] overflow-hidden bg-beige md:aspect-auto md:h-full"
      aria-label={`Découvrir le projet ${featuredProject.title}`}
    >
      <img
        src={featuredProject.images[2]}
        alt={`Intérieur du projet ${featuredProject.title} — détail, ${featuredProject.location}`}
        loading="lazy"
        width="1200"
        height="1600"
        class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
      />
    </a>
  </div>

  <p class="mt-14 max-w-2xl leading-relaxed text-anthracite/80" data-reveal>
    {featuredProject.description}
  </p>

  <div class="mt-14 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-pierre/40 pt-10 sm:grid-cols-4" data-reveal>
    {
      meta.map((item) => (
        <div>
          <p class="text-[0.65rem] tracking-[0.2em] text-anthracite/50 uppercase">{item.label}</p>
          <p class="mt-1 text-sm text-anthracite/80">{item.value}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-16 text-center" data-reveal>
    <a
      href="/projets"
      class="inline-block border border-anthracite px-8 py-3 text-xs tracking-[0.2em] uppercase transition-colors hover:bg-anthracite hover:text-ivoire"
    >
      Voir d'autres projets
    </a>
  </div>
</section>
