---
import { PSWP_HEIGHT, PSWP_WIDTH } from "../data/projects";

interface Props {
  project: {
    id: string;
    title: string;
    category: string;
    location: string;
    year: string;
    cover: string;
    images: string[];
  };
  categoryLabel: string;
}

const { project, categoryLabel } = Astro.props;
---

<div
  class="pswp-gallery group cursor-pointer"
  data-category={project.category}
  data-stagger-item
>
  {
    project.images.map((image, i) => (
      <a
        href={image}
        data-pswp-width={PSWP_WIDTH}
        data-pswp-height={PSWP_HEIGHT}
        class={i === 0 ? "block" : "hidden"}
        aria-label={`Ouvrir la galerie — ${project.title}`}
      >
        {i === 0 && (
          <>
            <div class="aspect-[4/3] overflow-hidden bg-beige">
              <div class="h-full w-full will-change-transform" data-parallax-card>
                <img
                  src={project.cover}
                  alt={`Intérieur du projet ${project.title} — ${categoryLabel}, ${project.location}`}
                  loading="lazy"
                  width={PSWP_WIDTH}
                  height={PSWP_HEIGHT}
                  class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.08]"
                />
              </div>
            </div>
            <div class="mt-4 flex items-baseline justify-between">
              <div>
                <p class="font-serif text-lg">{project.title}</p>
                <p class="text-xs tracking-wide text-anthracite/50">
                  {project.location} — {project.year}
                </p>
              </div>
              <span class="text-xs tracking-widest text-bronze uppercase">
                {categoryLabel}
              </span>
            </div>
          </>
        )}
      </a>
    ))
  }
</div>
