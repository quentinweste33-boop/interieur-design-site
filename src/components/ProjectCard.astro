---
interface Props {
  project: {
    id: string;
    title: string;
    category: string;
    location?: string;
    year?: string;
    cover: string;
    images: string[];
  };
  categoryLabel: string;
}

const { project, categoryLabel } = Astro.props;

// Lieu / année optionnels : on n'affiche que ce qui est renseigné.
const details = [project.location, project.year].filter(Boolean).join(", ");
const caption = details ? `${categoryLabel} — ${details}` : categoryLabel;
---

<a
  href={`/projets/${project.id}`}
  class="project-card group block"
  data-category={project.category}
  data-stagger-item
>
  <div class="aspect-[4/3] overflow-hidden bg-beige">
    <div class="h-full w-full will-change-transform" data-parallax-card>
      <img
        src={project.cover}
        alt={`Intérieur du projet ${project.title} — ${categoryLabel}${project.location ? `, ${project.location}` : ""}`}
        loading="lazy"
        width="1600"
        height="1067"
        class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.08]"
      />
    </div>
  </div>
  <div class="mt-4">
    <p class="font-serif text-lg font-normal">{project.title}</p>
    <p class="mt-1 text-xs tracking-[0.15em] text-anthracite/50 uppercase">
      {caption}
    </p>
  </div>
</a>
