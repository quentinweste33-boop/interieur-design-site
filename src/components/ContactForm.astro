<!--
  Formulaire branché sur FormSubmit (https://formsubmit.co), sans compte ni
  backend à gérer : les envois arrivent par email à interieurdesigntahiti@gmail.com.
  Au tout premier envoi, FormSubmit demande une confirmation unique par email
  (lien à cliquer une seule fois) avant d'activer la réception — c'est normal.
-->
<form
  action="https://formsubmit.co/interieurdesigntahiti@gmail.com"
  method="POST"
  class="space-y-8"
  data-reveal
>
  <input type="hidden" name="_subject" value="Nouveau message — site Interieur Design Tahiti" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="true" />
  <div>
    <label for="name" class="mb-2 block text-xs tracking-wide text-anthracite/60 uppercase"
      >Nom</label
    >
    <input
      id="name"
      name="name"
      type="text"
      autocomplete="name"
      required
      class="w-full border-b border-pierre bg-transparent py-2 text-anthracite outline-none transition-colors focus:border-anthracite"
    />
  </div>

  <div>
    <label for="email" class="mb-2 block text-xs tracking-wide text-anthracite/60 uppercase"
      >Email</label
    >
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      required
      class="w-full border-b border-pierre bg-transparent py-2 text-anthracite outline-none transition-colors focus:border-anthracite"
    />
  </div>

  <div>
    <label
      for="message"
      class="mb-2 block text-xs tracking-wide text-anthracite/60 uppercase">Message</label
    >
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full resize-none border-b border-pierre bg-transparent py-2 text-anthracite outline-none transition-colors focus:border-anthracite"
    ></textarea>
  </div>

  <button
    type="submit"
    class="border border-vert-sapin px-8 py-3 text-xs tracking-[0.2em] uppercase transition-colors hover:bg-vert-sapin hover:text-ivoire"
  >
    Envoyer le message
  </button>

  <p class="text-xs text-anthracite/40">
    Vous pouvez aussi écrire directement à <a
      href="mailto:interieurdesigntahiti@gmail.com"
      class="underline hover:text-bronze">interieurdesigntahiti@gmail.com</a
    >.
  </p>
</form>
