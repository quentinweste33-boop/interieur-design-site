---
// Galerie photo en séquence pure, inspirée de lauragonzalez.fr/projets/ :
// aucune légende sur les photos (le texte d'intro vit une seule fois en
// haut de la fiche projet), alternance plein cadre / 2 photos accolées,
// bord à bord (aucun espace horizontal ni vertical entre les images), et
// chaque photo garde son ratio d'origine (aucun recadrage, donc aucune
// photo tronquée) sans jamais être affichée au-delà de sa taille réelle,
// pour ne pas flouter les sources basse résolution.
//
// Mise en page : les paysages HD (>= 1600 px) occupent toute la largeur ;
// les autres photos se rangent deux par deux, collées l'une à l'autre ;
// une photo restée seule est centrée sur une demi-largeur.
interface Photo {
  src: string;
  width: number;
  height: number;
  alt: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

const isWide = (p: Photo) => p.width > p.height && p.width >= 1600;

const rows: Photo[][] = [];
for (let i = 0; i < photos.length; i++) {
  if (isWide(photos[i]) || i === photos.length - 1 || isWide(photos[i + 1])) {
    rows.push([photos[i]]);
  } else {
    rows.push([photos[i], photos[i + 1]]);
    i++;
  }
}
---

<div class="space-y-0">
  {
    rows.map((row) => {
      const single = row.length === 1;
      const wide = single && isWide(row[0]);
      return (
        <div
          class={
            single
              ? wide
                ? ""
                : "mx-auto md:w-1/2"
              : "grid grid-cols-1 items-center gap-0 md:grid-cols-2"
          }
          data-reveal
        >
          {row.map((photo) => (
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
              width={photo.width}
              height={photo.height}
              style={`max-width:${photo.width}px`}
              class="mx-auto block h-auto w-full bg-beige"
            />
          ))}
        </div>
      );
    })
  }
</div>
